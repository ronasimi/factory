{
  "name": "@ronasimi/factory",
  "version": "0.1.0",
  "description": "Companion agent harness built over earendil-works/pi v1.6.0 with dual-model LFM3 routing and Self-Improvement Memory (SIM).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "factory": "./dist/bin/factory.js"
  },
  "pi": {
    "extensions": [
      "./dist/src/extension/index.js"
    ]
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "bundle": "npm run build && node scripts/build-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "start": "node ./dist/bin/factory.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "pi-web-access": "^0.48.0",
    "typebox": "1.3.27"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  }
}
